# Publish only the source, build inputs, tests and public project documents.
/*
!/.gitignore
!/LICENSE
!/Package.swift
!/README.md
!/README.de.md
!/SECURITY.md
!/Sources/
!/Tests/
!/Scripts/
!/Resources/
/Resources/*
!/Resources/Info.plist
!/Resources/NZBPort.icon/
.DS_Store
*.swp
*.bak
*.orig
.env
.env.*
*.p12
*.key

# Screenshots approved for public documentation.
!/docs/
/docs/*
!/docs/screenshots/
/docs/screenshots/*
!/docs/screenshots/nzbport-main.png
!/docs/screenshots/nzbport-settings.png

# Public project rules and continuation context; other internal documents stay local.
!/AGENTS.md
!/Documentation/
/Documentation/*
!/Documentation/Project/
/Documentation/Project/*
!/Documentation/Project/AGENTS.md
!/Documentation/Project/PROJECT_CONTEXT.md
!/Documentation/Project/NEXT_STEPS.md
!/Documentation/Project/CHAT_TEMPLATE.md
